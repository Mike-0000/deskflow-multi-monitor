{
  "name": "com.deskflow.control",
  "version": "1.26.0",
  "description": "Deskflow Stream Deck plugin — pause/resume sharing with live button state",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.deskflow.control\"",
    "pack": "npm run build && streamdeck pack com.deskflow.control.sdPlugin -f -o dist",
    "validate": "streamdeck validate com.deskflow.control.sdPlugin",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.8.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^22.13.0",
    "rollup": "^4.32.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
